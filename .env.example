# Model backend selection: "claude" (default), "ollama", or "deepseek".
# A single value applies uniformly to the orchestrator and every subagent in the run.
AGENTICXL_MODEL_BACKEND=claude

# Required when AGENTICXL_MODEL_BACKEND=claude (or unset).
ANTHROPIC_API_KEY=

# Optional: override the Claude model id (defaults to claude-sonnet-5 in code).
AGENTICXL_CLAUDE_MODEL=claude-sonnet-5

# Required when AGENTICXL_MODEL_BACKEND=ollama.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Required when AGENTICXL_MODEL_BACKEND=deepseek.
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek model id (defaults to deepseek-v4-pro in code).
# deepseek-v4-flash is the other current option (cheaper, lower concurrency).
# Note: deepseek-chat/deepseek-reasoner are deprecated 2026/07/24 -- don't use them.
AGENTICXL_DEEPSEEK_MODEL=deepseek-v4-pro

# Required for Stage 3 web-search enrichment fallback (https://serper.dev).
SERPER_API_KEY=

# Optional: set truthy (1/true/yes/on) to stop after Stage 2 (consolidation) and
# skip Stage 3 enrichment entirely. The CLI's --skip-enrichment flag overrides
# whatever this resolves to.
AGENTICXL_SKIP_ENRICHMENT=false
